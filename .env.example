# Copiá este archivo como `.env.local` y completá los valores para activar la
# sincronización con Supabase. Sin estas variables la app funciona igual, pero
# 100% local (los datos viven sólo en el dispositivo).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# --- Panel de administración (/admin) ---------------------------------------
# SÓLO servidor: NO lleva prefijo NEXT_PUBLIC_ y nunca se expone al navegador.
# Se usa en los Route Handlers de src/app/api/admin/* para leer métricas
# agregadas (bypassa RLS). Settings → API → "service_role secret".
# Sin esta variable, /admin responde 503. Ver docs/ADMIN.md.
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Puesta en marcha del backend:
#   1. Crear un proyecto en https://supabase.com
#   2. Aplicar las migraciones de supabase/migrations/ en orden (SQL editor o CLI):
#      0001..0004 (esquema + sync) y 0005..0007 (Etapa 7: auth + membresía + RLS).
#   3. Authentication → Providers → habilitar "Anonymous sign-ins".
#      (El acceso a los grupos usa RLS + usuarios anónimos de Supabase; sin esto
#       ningún push/pull pasa.)
#   4. En Database → Replication, habilitar Realtime para las tablas
#      groups, participants, expenses, payments.
#   5. Copiar Project URL y anon key (Settings → API) a este archivo.
#
# Nota sobre grupos preexistentes: al aplicar 0007, los grupos creados antes (sin
# dueño) quedan invisibles. Ver el comentario al pie de
# supabase/migrations/0007_rls_auth.sql para el paso manual de "claim".
