{
  "name": "fivi",
  "version": "0.20.1",
  "private": true,
  "description": "PWA offline-first para dividir gastos compartidos entre un grupo de personas.",
  "engines": {
    "node": ">=20.11.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/gen-precache.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^25.10.10",
    "next": "^15.5.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.4",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.24",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
